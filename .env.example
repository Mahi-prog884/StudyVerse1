# Copy this file to ".env" and keep ONE of the options below. Never share the real .env.
# AI is optional: without it the game still works and your history is still saved.

# ---- Option A: Anthropic Claude (default) ----
ANTHROPIC_API_KEY=your-key-here
# ANTHROPIC_MODEL=claude-sonnet-5-5

# ---- Option B: OpenAI or any OpenAI-compatible service (Groq, OpenRouter, Together...) ----
# AI_PROVIDER=openai
# OPENAI_API_KEY=your-key-here
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# ---- Option C: FREE local model with Ollama (install from ollama.com, then: ollama pull llama3.1) ----
# AI_PROVIDER=openai
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_MODEL=llama3.1

# ---- Qwen (e.g. qwen/qwen3.8-27b): use ONE of these two ----
# (a) Running on your own PC with LM Studio (start its Local Server, Developer tab):
# AI_PROVIDER=openai
# OPENAI_BASE_URL=http://localhost:1234/v1
# OPENAI_MODEL=qwen/qwen3.8-27b
# (b) Hosted on OpenRouter (key from openrouter.ai):
# AI_PROVIDER=openai
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_API_KEY=your-openrouter-key
# OPENAI_MODEL=qwen/qwen3.8-27b
# Optional for reasoning models: skip the "thinking" phase (faster) / change token room (default 3x)
# AI_NO_THINK=1
# AI_TOKEN_BOOST=3

# PORT=3000
